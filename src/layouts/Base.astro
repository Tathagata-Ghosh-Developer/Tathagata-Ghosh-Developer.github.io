---
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content="#0b0d10" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%230b0d10'/%3E%3Crect x='4' y='4' width='8' height='8' fill='%235cf29a'/%3E%3C/svg%3E" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Tathagata Ghosh" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Tathagata Ghosh: I make tensors smaller and clusters busier." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />
  <!-- html.anim = motion allowed (no OS reduced motion, toggle off). html[data-plain] = plain mode: the
       compact text page only (reduced motion, the toggle, or the "Plain mode" link). -->
  <script is:inline>(function(){var h=document.documentElement,r=false,p=false;h.classList.add('js');try{r=localStorage.getItem('motion')==='reduce';p=sessionStorage.getItem('plain')==='1'}catch(e){}if(r)h.dataset.motion='reduce';if(!r&&!matchMedia('(prefers-reduced-motion: reduce)').matches)h.classList.add('anim');else p=true;if(p)h.dataset.plain=''})()</script>
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root {
    --bg: #0b0d10;
    --panel: #11151a;
    --line: #232a33;
    --text: #e6eaef;
    --muted: #9aa5b1;
    --accent: #5cf29a;
    --amber: #f2b35c;
    --ink: #06140c;
    --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color-scheme: dark;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 0.95rem/1.55 var(--mono); overflow-wrap: break-word; overflow-x: clip; }
  a { color: var(--accent); text-underline-offset: 0.2em; }
  a:hover { color: var(--text); }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  h1, h2, h3 { line-height: 1.2; margin: 0; font-size: inherit; }
  p { margin: 0; }
  ul, ol { margin: 0; padding: 0; list-style: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .skip { position: absolute; left: 16px; top: -4rem; background: var(--accent); color: var(--ink); padding: 0.5rem 1rem; border-radius: 6px; z-index: 50; }
  .skip:focus { top: 1rem; }
  .wrap { max-width: 72rem; margin: 0 auto; padding: 0 16px; }
  .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.1rem; border: 1px solid var(--line); border-radius: 999px; color: var(--text); text-decoration: none; font: 600 0.9rem/1 var(--mono); background: rgba(17, 21, 26, 0.85); }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--ink); }
  .btn.primary:hover { background: var(--text); border-color: var(--text); color: var(--ink); }

  /* plain mode: the whole site as a compact transcript (always in the DOM; the terminal replays it) */
  .plain { position: relative; z-index: 1; background: var(--bg); padding: 3rem 0 4rem; }
  .plain header { display: grid; gap: 0.4rem; margin-bottom: 2rem; }
  .plain h1 { font-size: clamp(1.6rem, 1.1rem + 2.4vw, 2.6rem); letter-spacing: -0.01em; }
  .plain .kick { color: var(--muted); }
  .plain .links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.6rem; }
  .plain section { padding: 1.4rem 0; border-top: 1px solid var(--line); }
  .plain h2 { color: var(--accent); margin-bottom: 0.6rem; font-weight: 600; }
  .plain h2::before { content: "$ "; color: var(--muted); }
  .plain h3 { font-weight: 700; }
  .plain .muted, .plain small { color: var(--muted); }
  .plain .n { color: var(--accent); font-weight: 700; }
  .grid { display: grid; gap: 1rem 2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .grid > li { display: grid; gap: 0.2rem; align-content: start; }
  .plain li li::before { content: "- "; color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .chips li { font-size: 0.75rem; color: var(--muted); border: 1px solid var(--line); padding: 0 0.45rem; border-radius: 999px; }
  .chips li::before { content: none !important; }
  .rows li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; }
  /* the terminal stage: fixed behind a tall scroll track; the transcript scrolls over it at the end */
  :root { --dock: 6rem; }
  html:not(.js) .stage, html:not(.js) .dock, html:not(.js) .track { display: none; }
  .stage { position: fixed; inset: 0 0 var(--dock) 0; z-index: 0; overflow: hidden; background: #020a05; touch-action: pan-y; }
  .stage > canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .stage > #term { z-index: 1; top: 1.7rem; height: calc(100% - 3.2rem); object-fit: contain; }
  .stage > astro-island { position: absolute; inset: 0; z-index: 0; display: block; }
  .stage::after { content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.22) 2px 3px), radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.6)); }
  .stage[data-live] #term { visibility: hidden; }
  .stage[data-live]::after { display: none; }
  .stage:has(#term-in:focus-visible)::before { content: ""; position: absolute; inset: 4px; z-index: 5; border: 2px solid var(--accent); border-radius: 6px; pointer-events: none; }
  #term-in { position: absolute; left: 0; top: 0; width: 1px; height: 1px; padding: 0; border: 0; opacity: 0; font-size: 16px; pointer-events: none; }
  .tag { position: absolute; z-index: 3; top: 0.5rem; left: 16px; right: 16px; font-size: 0.72rem; color: var(--muted); pointer-events: none; }
  .hint { position: absolute; z-index: 3; left: 16px; right: 16px; bottom: 0.4rem; text-align: center; font-size: 0.72rem; color: var(--muted); pointer-events: none; }
  .term-links { position: absolute; z-index: 4; right: 16px; bottom: 1.8rem; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.5rem; max-width: calc(100% - 32px); }
  .term-links[hidden] { display: none; }
  .track { height: calc(12 * 70vh + 100vh); }
  .dock { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; height: var(--dock); display: grid; align-content: center; gap: 0.45rem; padding: 0.4rem 0 calc(0.4rem + env(safe-area-inset-bottom)); background: var(--bg); border-top: 1px solid var(--line); }
  .cmds { display: flex; gap: 0.4rem; overflow-x: auto; padding: 0.15rem 16px; scrollbar-width: none; }
  .cmds::-webkit-scrollbar { display: none; }
  .cmds button { flex: none; min-height: 2.2rem; padding: 0 0.7rem; border: 1px solid var(--line); border-radius: 6px; background: #0f1519; color: var(--accent); font-size: 0.8rem; white-space: nowrap; }
  .cmds button:hover { border-color: var(--accent); }
  .dock nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.2rem 1.2rem; font-size: 0.8rem; padding: 0 16px; }
  .dock nav a, .dock nav button { min-height: 1.6rem; color: var(--muted); }
  .dock nav a:hover, .dock nav button:hover, .dock nav button[aria-pressed="true"] { color: var(--accent); }
  html[data-plain] .stage { position: relative; inset: auto; height: min(70vh, 40rem); }
  html[data-plain] .dock { position: relative; height: auto; }
  html[data-plain] .track { display: none; }
  html:not([data-plain]) footer { padding-bottom: calc(var(--dock) + 1.5rem); }

  footer { position: relative; z-index: 1; background: var(--bg); padding: 1.5rem 16px 2rem; color: var(--muted); font-size: 0.8rem; border-top: 1px solid var(--line); text-align: center; }
</style>
