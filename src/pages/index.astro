---
import Base from '../layouts/Base.astro';
import s from '../data/site.json';

// Every fact and number comes from site.json (built from the master profile outside this repo).
// This file is the plain mode: the whole site as a compact transcript, always in the DOM for screen
// readers and crawlers, and the page itself under reduced motion.
const { github, linkedin } = s.links;
const t = s.thesis;
const cmds = ['help', 'whoami', 'top', 'ls projects/', 'open hydra', 'nvidia-smi', 'history', 'ssh iiest', 'ssh iisc', 'cat thesis.md', 'cd ~/offduty', 'make chai', 'ride', 'adda', 'sleep', 'sudo hire tathagata', 'exit'];
---
<Base title="Tathagata Ghosh · HPC and GPU computing" description="Tathagata Ghosh, M.Tech CDS at IISc Bangalore. Multi-GPU tensor decompositions, MPI and CUDA, and the numbers behind them.">
  <a class="skip" id="plain-link" href="#plain">Plain mode</a>

  <!-- The terminal. #hero-visual hosts the 2D canvas (always) and the 3D room (when it may run). -->
  <div class="stage" id="hero-visual">
    <canvas id="term" aria-hidden="true"></canvas>
    <label class="sr" for="term-in">Terminal: type a command such as help, then Enter. Tab completes. Escape leaves the shell.</label>
    <input id="term-in" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="go" />
    <p class="tag" aria-hidden="true">Tathagata Ghosh · HPC · GPU · IISc</p>
    <div class="term-links" id="term-links" hidden></div>
    <p class="hint" aria-hidden="true">scroll to replay a session · or tap and type</p>
  </div>

  <div class="dock">
    <div class="cmds" role="group" aria-label="Commands">{cmds.map((c) => <button type="button" data-cmd={c}>{c}</button>)}</div>
    <nav aria-label="Site">
      <button type="button" id="plain-btn">plain mode</button>
      <button type="button" id="motion-btn" aria-pressed="false">reduce motion</button>
      <a href={github}>GitHub</a>
      <a href={linkedin}>LinkedIn</a>
    </nav>
  </div>
  <div class="track" id="track" aria-hidden="true"></div>
  <div class="sr" id="term-log" aria-live="polite"></div>

  <main class="plain" id="plain">
    <div class="wrap">
      <header>
        <h1>{s.name}</h1>
        <p class="kick">I make tensors smaller and clusters busier.</p>
        <p class="links"><a class="btn primary" href={github}>GitHub</a><a class="btn" href={linkedin}>LinkedIn</a></p>
      </header>

      <section aria-labelledby="h-who">
        <h2 id="h-who">whoami</h2>
        <ul>{s.whoami.map((l) => <li>{l}</li>)}</ul>
      </section>

      <section aria-labelledby="h-top">
        <h2 id="h-top">top</h2>
        <ul class="grid">
          {s.gauges.map((g) => <li><p><span class="n">{g.n}</span> {g.label}</p><small>{g.cond}</small></li>)}
        </ul>
      </section>

      <section aria-labelledby="h-thesis">
        <h2 id="h-thesis">cat thesis.md</h2>
        <h3>{t.title}</h3>
        <p class="muted">{t.lab} · {t.with} · {t.when}</p>
        <ul>{t.lines.slice(2).map((l) => <li>{l}</li>)}</ul>
      </section>

      <section aria-labelledby="h-proj">
        <h2 id="h-proj">ls projects/</h2>
        <ul class="grid">
          {s.projects.map((p) => (
            <li id={`p-${p.id}`}>
              <h3>{p.name}{p.size !== '-' && <span class="n"> {p.size}</span>}</h3>
              <p>{p.line}</p>
              <ul>{p.bullets.map((b) => <li>{b}</li>)}</ul>
              {p.cond && <small>{p.cond}</small>}
              <ul class="chips">{p.chips.map((c) => <li>{c}</li>)}</ul>
              <small>{p.when} · <a href={p.proof}>Proof: {p.proofLabel}<span class="sr"> ({p.name})</span></a></small>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="h-hist">
        <h2 id="h-hist">history</h2>
        <ul class="rows">{s.history.map(([d, l]) => <li><span class="muted">{d}</span><span>{l}</span></li>)}</ul>
        <ul class="grid" style="margin-top:1rem">
          {Object.values(s.campuses).map((c) => <li><h3>{c.name}</h3>{c.lines.map((l) => <p>{l}</p>)}</li>)}
          {s.experience.map((x) => <li><h3>{x.title}, {x.org} <span class="muted">{x.when}</span></h3>{x.lines.map((l) => <p>{l}</p>)}</li>)}
        </ul>
      </section>

      <section aria-labelledby="h-skills">
        <h2 id="h-skills">cat skills.txt ranks.txt</h2>
        <ul>{s.skills.map((g) => <li><span class="n">{g.label}:</span> {g.items.join(', ')}</li>)}</ul>
        <ul style="margin-top:0.6rem">{s.ranks.map((r) => <li><span class="n">{r.n}</span> {r.label}</li>)}</ul>
      </section>

      <section aria-labelledby="h-off">
        <h2 id="h-off">cd ~/offduty</h2>
        <p>{s.hobbies.map((h) => h.label + (h.note ? ` (${h.note})` : '')).join(' · ')}</p>
        <ul style="margin-top:0.6rem">{s.facts.map((f) => <li>{f}</li>)}</ul>
      </section>

      <section aria-labelledby="h-exit">
        <h2 id="h-exit">exit</h2>
        <p class="links"><a class="btn primary" href={github}>GitHub</a><a class="btn" href={linkedin}>LinkedIn</a></p>
        <p class="muted" style="margin-top:0.6rem">No email here by design; LinkedIn messages reach me.</p>
      </section>
    </div>
  </main>
  <footer>Built with Astro. Every number on this page is a measured one.</footer>
</Base>

<script>
  import '../lib/term';
  // Plain mode and reduce motion are page modes: flip the flag and reload (sessionStorage / localStorage, try/catch).
  const h = document.documentElement, isPlain = h.hasAttribute('data-plain'), reduced = h.dataset.motion === 'reduce';
  const os = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const save = (st: Storage, k: string, v: string | null) => { try { v === null ? st.removeItem(k) : st.setItem(k, v); } catch {} };
  const plainLink = document.getElementById('plain-link') as HTMLAnchorElement, plainBtn = document.getElementById('plain-btn')!;
  const motionBtn = document.getElementById('motion-btn')!;
  if (isPlain && !reduced && !os) { plainLink.textContent = 'Terminal mode'; plainBtn.textContent = 'terminal mode'; }
  motionBtn.setAttribute('aria-pressed', String(reduced));
  const togglePlain = (e: Event) => {
    if (isPlain && (reduced || os)) return; // plain is the only mode here: the link just jumps to the transcript
    e.preventDefault();
    save(sessionStorage, 'plain', isPlain ? null : '1');
    location.href = location.pathname + (isPlain ? '' : '#plain');
    location.reload();
  };
  plainLink.addEventListener('click', togglePlain);
  plainBtn.addEventListener('click', togglePlain);
  motionBtn.addEventListener('click', () => { save(localStorage, 'motion', reduced ? null : 'reduce'); save(sessionStorage, 'plain', null); location.reload(); });
</script>
